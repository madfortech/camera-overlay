{
    "name": "madfortech/camera-overlay",
    "description": "NativePHP camera recorder with teleprompter overlay",
    "type": "nativephp-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "nativephp/mobile": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Madfortech\\CameraOverlay\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Madfortech\\CameraOverlay\\CameraOverlayServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    }
}
